# 이 파일은 설정 항목의 목록입니다. 실제 값은 .env 파일(저장소에 올라가지 않음)에 넣으세요.

# 데이터베이스 (개발: SQLite 파일 / 운영: Neon Postgres 주소로 교체 예정)
DATABASE_URL=file:./cubit.db
# 로그인·암호화에 쓰는 비밀 문자열 (길고 무작위한 값)
PAYLOAD_SECRET=YOUR_SECRET_HERE
# 사이트 주소 (메일 속 관리자 링크 등에 사용)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 자동 번역 (Claude API). 비워 두면 "[ja] 원문" 형태의 개발용 가짜 번역을 씁니다.
ANTHROPIC_API_KEY=
# 번역 모델 (기본: claude-opus-5-5)
TRANSLATION_MODEL=

# 메일 발송 (Resend). 비워 두면 메일은 개발 서버 화면에만 찍힙니다.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@cubitenter.com
EMAIL_FROM_NAME=CUBIT ENTERTAINMENT

# Vercel 정기 호출이 예약 작업을 실행할 때 쓰는 비밀 문자열 (Vercel 환경 변수에도 같은 값)
CRON_SECRET=

# true로 두면 예약 작업(번역·메일)을 자동으로 처리하지 않습니다 (시험용)
DISABLE_JOB_AUTORUN=
