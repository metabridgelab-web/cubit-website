# 이 파일은 설정 항목의 목록입니다. 실제 값은 .env 파일(저장소에 올라가지 않음)에 넣으세요.

# 데이터베이스
# - 개발: SQLite 파일 (file:./cubit.db)
# - 운영: Neon Postgres 주소 (postgresql://… 로 시작). Vercel에서 Neon을 연결하면 자동으로 들어간다.
DATABASE_URL=file:./cubit.db
# 로그인·암호화에 쓰는 비밀 문자열 (길고 무작위한 값)
PAYLOAD_SECRET=YOUR_SECRET_HERE
# 사이트 주소 (메일 속 관리자 링크 등에 사용)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 자동 번역 (Claude API). 비워 두면 "[ja] 원문" 형태의 개발용 가짜 번역을 씁니다.
ANTHROPIC_API_KEY=
# 번역 모델 (기본: claude-opus-5-5)
TRANSLATION_MODEL=

# 메일 발송 (Resend). 비워 두면 메일은 개발 서버 화면에만 찍힙니다.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@mail.cubitenter.com
EMAIL_FROM_NAME=CUBIT ENTERTAINMENT

# Vercel 정기 호출이 예약 작업을 실행할 때 쓰는 비밀 문자열 (Vercel 환경 변수에도 같은 값)
CRON_SECRET=

# Cloudflare R2 파일 저장소 (모두 채워야 켜짐. 비우면 프로젝트의 media 폴더에 저장)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 공개 버킷(사진·영상·PDF)과 비공개 버킷(문의 첨부 파일) 이름
R2_PUBLIC_BUCKET=cubit-media
R2_PRIVATE_BUCKET=cubit-private
# 공개 버킷의 주소 (예: https://media.cubitenter.com 또는 https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# Cloudflare Stream 고객 코드 (영상 주소 customer-XXXX.cloudflarestream.com 의 XXXX)
CF_STREAM_CUSTOMER_CODE=

# true로 두면 예약 작업(번역·메일)을 자동으로 처리하지 않습니다 (시험용)
DISABLE_JOB_AUTORUN=
